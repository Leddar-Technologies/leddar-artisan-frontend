{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
, "src/views/JobDetails.jsx", "src/views/Jobs.jsx", "src/views/KYC.jsx", "src/views/Payments.jsx", "src/views/Profile.jsx", "src/views/auth/Login.jsx", "src/views/auth/Signup.jsx", "src/views/Dashboard.jsx"  ],
  "exclude": [
    "node_modules"
  ]
}